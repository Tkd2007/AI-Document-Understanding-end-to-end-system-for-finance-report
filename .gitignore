# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*

# Data - real financial reports should NOT be pushed to a public repo
data/samples/*
data/output/*
!data/samples/.gitkeep
!data/output/.gitkeep
!data/samples/sample_report.png

# Ngoai le: bao cao identifiability la KET QUA NGHIEN CUU, khong phai
# output tam. No sinh ra tu ma tran rang buoc chu khong tu bao cao tai
# chinh nao, nen khong co du lieu doanh nghiep trong do. Phai vao git vi
# Moc 1 bat nguoi chu tri doc va doi chieu no voi Thong tu, va lan doi
# chieu do can neo vao mot commit cu the.
!data/output/identifiability_*.md

# Ngoai le: bao cao do engine OCR cung la KET QUA NGHIEN CUU. No do tren
# bang TONG HOP sinh bang ham bang_tong_hop(), khong dung mot bao cao tai
# chinh that nao, nen khong co du lieu doanh nghiep trong do. Phai vao git
# vi no la bang chung cho quyet dinh GIU EasyOCR — thu ma reviewer se hoi,
# va cau tra loi can neo vao mot commit cu the.
!data/output/ocr_engine_*.md

# Ngoai le: bao cao Moc 3. No do tren ho so XBRL cong khai cua SEC, khong
# co du lieu doanh nghiep Viet Nam nao trong do. Phai vao git vi Moc 3 la
# mot MOC DUNG da dang ky truoc, va ket qua cua no — ke ca ket qua chua
# ket luan duoc — phai neo vao mot commit cu the de doi chieu lai.
!data/output/moc3_*.md

# Ngoai le: ma tran nham chu so. Do bang EasyOCR tren bang TONG HOP sinh
# bang bang_tong_hop(), khong dung mot bao cao tai chinh that nao. Phai vao
# git vi ca bo tiem loi lan bo sinh ung vien deu duoc hieu chinh tu no, va
# dang ky truoc doi ma tran phai co dau thoi gian TRUOC luot chay Moc 3 —
# khong neo vao mot commit cu the thi khong chung minh duoc thu tu do.
!data/output/ma_tran_nham_chu_so_*.md
!data/output/ma_tran_nham_chu_so_*.json

# Ngoai le: phep do tieu de co lot vao vung bang da cat khong. Do tren bao
# cao VNM that, nhung thu ghi ra chi la DONG TIEU DE va TOA DO khung — kho
# co mot con so tai chinh nao trong do. Phai vao git vi no la cau tra loi
# cho Cau 3 muc 0, va cau tra loi day quyet dinh huong thi cong nhan dien
# chuan mau bieu.
!data/output/tieu_de_trong_vung_cat.md

# Van ban quy pham phap luat tai ve. Ban than van ban KHONG co ban quyen
# (Luat So huu tri tue dieu 15), nhung file PDF cong bao nang vai chuc MB va
# lay lai duoc bat cu luc nao tu congbao.chinhphu.vn, nen khong dua vao git.
# Thu can vao git la BANG DOI CHIEU rut ra tu chung: MOC1-DOI-CHIEU.md.
data/legal/*
!data/legal/.gitkeep

# Ho so XBRL tai tu EDGAR. Du lieu cua chinh phu My nen khong vuong ban
# quyen, nhung nang vai MB va lay lai duoc bat cu luc nao bang fetch.py —
# cung ly do da ap cho data/legal/. Thu can vao git la KET QUA rut ra tu
# chung: data/output/moc3_*.md.
data/xbrl/*
!data/xbrl/.gitkeep

# OS/editor junk
.DS_Store
.vscode/